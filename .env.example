# --- Communication Hub configuration ---
# Copy to .env and fill in the channels you actually have.

# Comma-separated list of channels to enable. Options: imessage, ntfy
# Start with whatever you can actually reach today.
CHANNELS_ENABLED=ntfy

# Where the SQLite message log lives (inside the container).
HUB_DATABASE_PATH=/data/hub.db

# Shared secret required on write endpoints (/messages/send, /webhooks/*).
# Send it as the `X-Hub-Token` header. Leave blank to disable auth (LAN-only).
HUB_API_TOKEN=

# --- iMessage channel (BlueBubbles server on a Mac) ---
# Base URL of the BlueBubbles server, e.g. http://mac.local:1234
BLUEBUBBLES_URL=
# BlueBubbles server password (used as the `password` query param).
BLUEBUBBLES_PASSWORD=
# Optional: default chat GUID to send to when a send omits `to`.
BLUEBUBBLES_DEFAULT_GUID=

# --- ntfy channel (Pi-native push, https://ntfy.sh or self-hosted) ---
# Base URL of the ntfy server. Use https://ntfy.sh or your self-hosted instance.
NTFY_URL=https://ntfy.sh
# Optional bearer token for protected topics.
NTFY_TOKEN=
