# --- CustomComms client config ---
# Copy to .env.local for local dev (Vite reads it; .env.local is git-ignored).

# Where the hub lives. In dev, point at the hub over Tailscale, e.g.
#   VITE_HUB_URL=http://<pi-tailscale-ip>:8000
# In production the hub serves this app same-origin, so leave this empty.
VITE_HUB_URL=

# Hub API token (matches HUB_API_TOKEN in the hub's .env). Required to send
# messages / reactions. Baked into the client bundle at build time — fine for a
# private, tailnet-only deployment.
VITE_HUB_TOKEN=
